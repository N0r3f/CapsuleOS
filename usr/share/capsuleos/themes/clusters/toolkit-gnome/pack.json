  "sync": {
    "canonicalSkinRoot": "home/RedHat/Rocky",
    "targets": [
      {
        "id": "fedora",
        "bodyId": "fedora",
        "skinRoot": "home/RedHat/Fedora",
        "profileId": "linux-fedora",
        "slotOverlays": {
          "terminal": "home/RedHat/Fedora/style/apps/terminal.overlay.css"
        }
      },
      {
        "id": "ubuntu",
        "bodyId": "ubuntu",
        "skinRoot": "home/Debian/Ubuntu",
        "profileId": "linux-ubuntu",
        "slotOverlays": {
          "terminal": "home/Debian/Ubuntu/style/apps/terminal.overlay.css"
        }
      },
      {
        "id": "alma",
        "bodyId": "alma",
        "skinRoot": "home/RedHat/Alma",
        "profileId": "linux-alma"
      },
      {
        "id": "anduinos",
        "bodyId": "anduinos",
        "skinRoot": "home/Debian/AnduinOS",
        "profileId": "linux-anduinos"
      }
    ],
    "excludeAppSkins": [
      "mainMenu.skin.css",
      "Dossier personnel.skin.css",
      "nemo.skin.css"
    ],
    "pipelines": [
      {
        "id": "nautilus",
        "type": "script",
        "path": "usr/lib/capsuleos/tools/linux/sync-gnome-nautilus-skin.mjs",
        "artifact": "style/apps/nautilus.skin.css"
      },
      {
        "id": "workstation",
        "type": "script",
        "path": "usr/lib/capsuleos/tools/linux/sync-gnome-workstation-skin.mjs",
        "artifact": "style/gnome-workstation.css",
        "targetIds": [
          "fedora",
          "ubuntu",
          "alma"
        ]
      },
      {
        "id": "utility-apps",
        "type": "script",
        "path": "usr/lib/capsuleos/tools/linux/sync-gnome-utility-app-skins.mjs",
        "slots": [
          "text_editor",
          "calculator",
          "clocks",
          "calendar",
          "baobab",
          "system_monitor",
          "tour",
          "characters"
        ]
      },
      {
        "id": "extended-app-skins",
        "type": "app-skins",
        "slots": [
          "profile",
          "checklist",
          "librewriter",
          "libreoffice_startcenter",
          "librecalc",
          "libreoffice_impress",
          "libreoffice_draw",
          "themes",
          "visionneur_images",
          "visionneur_pdf",
          "lecteur_multimedia",
          "snapshot",
          "screenshot",
          "update_manager",
          "firefox",
          "terminal",
          "gnome_disks",
          "font_viewer",
          "gnome_logs",
          "gnome_maps",
          "gnome_weather",
          "gnome_connections",
          "gnome_contacts",
          "gnome_boxes",
          "firmware_updater",
          "security_center",
          "language_support",
          "seahorse",
          "software_updater",
          "sysprof",
          "malcontent",
          "fedora_media_writer",
          "yelp"
        ]
      }
    ]
